# Local socket example for macOS; use a managed secret for shared environments.
TIGR_DATABASE_URL=postgresql+psycopg:///TIGR?host=/tmp
TIGR_OLLAMA_URL=http://127.0.0.1:11434
TIGR_OLLAMA_MODEL=gemma3:latest
TIGR_OLLAMA_REQUEST_TIMEOUT_SECONDS=480
TIGR_ENV=development
TIGR_API_PREFIX=/api/v1
TIGR_CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
TIGR_AUTH_MODE=development
# Set false when running the independent PostgreSQL outbox worker below.
TIGR_INLINE_JOBS=true
TIGR_OIDC_ISSUER=
TIGR_OIDC_AUDIENCE=
TIGR_OIDC_JWKS_URL=
TIGR_OIDC_ALGORITHMS=RS256
TIGR_NEO4J_URI=
TIGR_NEO4J_SECRET_REF=
TIGR_FILE_ROOTS=Docs/source_data
TIGR_ARTIFACT_ROOT=Docs/generated_data
# Required only for consistent tokenization masking rules.
TIGR_MASKING_SECRET=
# Required for stable, protected entity identity hashes across source refreshes.
# Keep this value unchanged once entity lineage has been recorded.
TIGR_IDENTITY_SECRET=
TIGR_SSD_ENABLED=true
TIGR_SSD_TEMPORARY_TTL_MINUTES=60
TIGR_SSD_MAX_ROWS=1000
