        governanceSvc["Governance services<br/>PII scan · masking · audit"]
        workflowSvc["Workflow services<br/>tickets · reservations · entity locks"]
        jobSvc["Job and outbox processing"]
        persistence["Database layer<br/>SQLAlchemy models and sessions"]
        connectionSvc --> persistence
        generationSvc --> persistence
        generationSvc --> jobSvc
        datasetSvc --> persistence
        governanceSvc --> persistence
        governanceSvc --> jobSvc
        workflowSvc --> persistence
        jobSvc --> persistence
    end

    subgraph data["Data stores and external systems"]
        direction TB
        iam[("TIGR PostgreSQL · IAM<br/>users · workspaces · memberships · grants")]
        dataops[("TIGR PostgreSQL · DataOps<br/>datasets · records · plans · tickets<br/>reservations · locks · jobs · audit")]
        sources[("Configured source systems<br/>databases · CSV and JSON files")]
        ollama["Optional local Ollama model<br/>scenario assistance"]
    end

    user --> ui
    apiClient -->|"HTTPS / REST"| cors
    errors -->|"HTTP response"| apiClient
